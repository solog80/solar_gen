# Felicity Solar Cloud API Credentials
FELICITY_CLOUD_EMAIL=your_email@example.com
FELICITY_CLOUD_PASSWORD=your_password

# QNAP NAS TimescaleDB Connection String
# Option A: Tailscale IP
