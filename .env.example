# TIMESCALE_URL=postgres://postgres:password@localhost:55439/analytics?sslmode=disable
# Option C: Local QNAP LAN IP (192.168.0.112)
# TIMESCALE_URL=postgres://postgres:password@192.168.0.112:55439/analytics?sslmode=disable

# Dashboard Server Settings
PORT=8085
JWT_SECRET=your_jwt_secret_key
