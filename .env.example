# Felicity Solar Cloud API Credentials
FELICITY_CLOUD_EMAIL=your_email@example.com
FELICITY_CLOUD_PASSWORD=your_password

# QNAP NAS TimescaleDB Connection String
# Option A: Tailscale IP
TIMESCALE_URL=postgres://postgres:password@100.116.185.70:55439/analytics?sslmode=disable
# Option B: Cloudflare Zero Trust TCP Tunnel Proxy (solar-analytics.solofx.net)
# Run first: cloudflared access tcp --hostname solar-analytics.solofx.net --url localhost:55439
# TIMESCALE_URL=postgres://postgres:password@localhost:55439/analytics?sslmode=disable
# Option C: Local QNAP LAN IP (192.168.0.112)
# TIMESCALE_URL=postgres://postgres:password@192.168.0.112:55439/analytics?sslmode=disable

# Dashboard Server Settings
PORT=8085
JWT_SECRET=your_jwt_secret_key

# Energy tariffs & FX (Time-of-Use, Uganda EAT hours)
TOU_OFFPEAK_UGX=414.00
TOU_DAY_UGX=546.00
TOU_PEAK_UGX=650.50
TOU_PEAK_START=18
TOU_DAY_START=6
USD_UGX_RATE=4050
